# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Blockchain Configuration - LOCALNET (Development Default)
# SECURITY FIX: Unified configuration to prevent account-not-found errors
NEXT_PUBLIC_SOLANA_NETWORK=localnet
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899

# Alternative RPC URLs for different networks
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Program Configuration - LOCALNET IDs (matches Anchor.toml localnet settings)
# SECURITY FIX: Use consistent localnet program IDs to match local deployment
NEXT_PUBLIC_ADMIN_WALLET="7Q3UBDfjZgNJNCQBdJrji33f2FvtJ1z3DErcAV6hFsf4"
NEXT_PUBLIC_TREASURY_WALLET="7Q3UBDfjZgNJNCQBdJrji33f2FvtJ1z3DErcAV6hFsf4"
NEXT_PUBLIC_LOTTERY_PROGRAM_ID="BH1qtDhU6PtB1jrUJPf8JoNt34ELuTvVTDktDLFyq2JV"
